[ext_resource type="Texture2D" path="res://assets/ui/icons/x-circle-fill.svg" id="icon_x_circle_fill"]

[node name="AboutPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
